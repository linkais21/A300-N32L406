+/* Median rejects one isolated sample; pair averaging attenuates alternating
+ * sensor noise without floating point. A persistent step reaches the span
+ * detector within three new polls (600 ms at the normal cadence). */
+static int16_t median3(int16_t a, int16_t b, int16_t c)
+{
+    if (a > b) { int16_t t = a; a = b; b = t; }
+    if (b > c) b = c;
+    return a > b ? a : b;
+}
+
+static void smooth_acceleration(accel_data_t *a)
+{
+    if (s_report.accel_count == 0u) {
+        s_report.previous_raw[0] = *a;
+        s_report.previous_raw[1] = *a;
+        s_report.previous_median = *a;
+    }
+    accel_data_t median;
+    median.x = median3(a->x, s_report.previous_raw[0].x, s_report.previous_raw[1].x);
+    median.y = median3(a->y, s_report.previous_raw[0].y, s_report.previous_raw[1].y);
+    median.z = median3(a->z, s_report.previous_raw[0].z, s_report.previous_raw[1].z);
+    s_report.previous_raw[1] = s_report.previous_raw[0];
+    s_report.previous_raw[0] = *a;
+    a->x = (int16_t)(((int32_t)median.x + s_report.previous_median.x) / 2);
+    a->y = (int16_t)(((int32_t)median.y + s_report.previous_median.y) / 2);
+    a->z = (int16_t)(((int32_t)median.z + s_report.previous_median.z) / 2);
+    s_report.previous_median = median;
 }
 
