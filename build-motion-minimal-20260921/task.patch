+    raw.lat += metres*cos(angle)/111319.5;
+    raw.lon += metres*sin(angle)/(111319.5*cos(raw.lat*0.0174532925199433));
+    if(raw.lon > 180.0) raw.lon -= 360.0;
+    if(raw.lon < -180.0) raw.lon += 360.0;
+}
